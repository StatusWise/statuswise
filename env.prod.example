# StatusWise Production Environment Configuration
# Copy this file to .env and update the values below

# Security Keys (REQUIRED - Generate strong random strings)
SECRET_KEY=your-super-secret-key-change-this
JWT_SECRET=your-jwt-secret-change-this

# Google OAuth Configuration (REQUIRED)
GOOGLE_CLIENT_ID=your-google-client-id-from-console
GOOGLE_CLIENT_SECRET=your-google-client-secret-from-console

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com

# Feature Toggles
ENABLE_BILLING=false
ENABLE_ADMIN=true

# Database Configuration (optional - defaults to postgres/postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=statuswise

# Port Configuration (optional - defaults shown)
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432

# URLs (update these for production)
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Lemon Squeezy Configuration (only if ENABLE_BILLING=true)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_PRO_VARIANT_ID=
